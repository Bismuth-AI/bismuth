# Bismuth is normally configured in the browser and stores its settings in
# ~/.bismuth/config.json. Use this file only for environment-based setup.
# Copy it to .env and uncomment the values you need.

# Bismuth reads BISMUTH_* variables, not provider-specific variables such as
# OPENAI_API_KEY.

# Hosted provider: anthropic or openai
# BISMUTH_PROVIDER_ID=openai
# BISMUTH_API_KEY=
# BISMUTH_MODEL=

# Local or other OpenAI-compatible endpoint
# BISMUTH_PROVIDER_ID=custom
# BISMUTH_API_BASE=http://localhost:11434/v1
# BISMUTH_MODEL=

# Vault and local server
# BISMUTH_VAULT_PATH=./vault
# BISMUTH_HOST=127.0.0.1
# BISMUTH_PORT=8765

# Optional tuning
# BISMUTH_LLM_MAX_CONCURRENCY=12
# BISMUTH_INGEST_READ_AHEAD=8
# BISMUTH_LLM_TIMEOUT_SECONDS=120
# BISMUTH_LLM_ABSOLUTE_TIMEOUT_SECONDS=180
# BISMUTH_LLM_MAX_SCHEMA_RETRIES=2
